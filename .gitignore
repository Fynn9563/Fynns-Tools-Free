# .meta files are intentionally NOT ignored. Unity uses them to track asset
# GUIDs; committing them keeps references stable for anyone installing this
# collection via git URL or a folder copy.

# Built packages
dist/
*.unitypackage

# Unity generated output
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Solution and project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE and tooling
.vs/
.vscode/
.idea/
*.DotSettings.user

# OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# Private dev notes
.dev/
